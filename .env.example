# ===================================
# Finance Analysis - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================


# 数据源配置
# 东方财富反爬补丁（可选）：true/false，默认 false。
# 仅在访问东方财富接口被风控时开启；开启后会为相关请求注入随机 UA 与授权 Cookie 并随机休眠。
# ENABLE_EASTMONEY_PATCH=false
# TickFlow API Key（可选，用于 A 股大盘复盘指数增强；若套餐支持标的池查询，也可增强市场统计）
# TICKFLOW_API_KEY=
# Longbridge OpenAPI（可选，美股/港股量比、换手率、PE 等字段兜底）
# 从 https://open.longbridge.com/ 获取
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 进程内缓存秒数，默认 86400；0=每次请求拉取
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 连接关闭类异常后的冷却秒数，默认 15；冷却期内会临时跳过 Longbridge，避免请求级频繁重连
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15

# 历史行情同步窗口与 Provider 任务级并发/重试。
# 全量同步和新股票首次回填默认覆盖最近 5 年；已有股票的每日增量同步默认覆盖最近 60 个自然日。
# 每日任务先比较最近 60 天同日期复权因子；如有变化则绕过批次缓存重新拉取并替换完整 5 年窗口。
# 每次任务发起行情请求前，先删除超过保留窗口的日线、公司行动和复权因子。
# MARKET_DATA_INITIAL_DAILY_DAYS=1825   # 全量同步和新股票首次回填窗口（自然日）
# MARKET_DATA_REFRESH_DAILY_DAYS=60     # 已有股票每日增量覆盖更新窗口（自然日）
# MARKET_DATA_TICKFLOW_BATCH_SIZE=100   # TickFlow 单次批量 K 线请求的 symbols 数量（最大 100）
# MARKET_DATA_TICKFLOW_MAX_CONCURRENCY=5 # TickFlow SDK 批量 K 线内部最大并发数
# MARKET_DATA_RETENTION_DAILY_DAYS=1825 # PostgreSQL 日线、公司行动和复权因子保留窗口（自然日）
# MARKET_DATA_LONGBRIDGE_MAX_CONCURRENCY=5
# MARKET_DATA_LONGBRIDGE_MAX_RETRIES=3
# MARKET_DATA_YFINANCE_MAX_CONCURRENCY=3
# MARKET_DATA_YFINANCE_MAX_RETRIES=3
# MARKET_DATA_YFINANCE_BATCH_SIZE=100  # yfinance 单次批量 K 线请求的 symbols 数量（最大 200）
# US 日线同步优先 Alpaca SIP（前复权），未配置或失败自动降级 yfinance。
# 仅用于同步，不影响实时行情、Streamer 或普通历史查询；密钥仅在后端读取。
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Longbridge SDK 语言与 REPORT_LANGUAGE（zh/en）一致。
# SDK 文件日志默认关闭；如需短期排障，可显式设置 LONGBRIDGE_LOG_PATH，排障后应及时移除。
# 接入点（与 REPORT_LANGUAGE 无关；留空则用下列默认值）：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 覆盖接入点；SDK 内部用 LONGPORT_REGION（不带 BRIDGE）自动选择，
# 代码会自动同步 LONGBRIDGE_REGION → LONGPORT_REGION。
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 其余见：https://open.longbridge.com/zh-CN/docs/getting-started#环境变量
# 夜盘行情 true/false，默认 false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K 线推送 realtime 或 confirmed，默认 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 连接时是否打印行情包（与 README / full-guide 一致：未设置时应用侧默认为关闭，等同 false）
# 设为 1 / true / yes 开启 SDK 详细行情包日志（调试长桥连接时使用）
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# ===================================
# LLM：单渠道或显式 AGY → Codex → API
# ===================================
LLM_BACKEND=api
# 初始调用 + 最多三次 retry（0–3），退避 2 / 4 / 8 秒
LLM_MAX_RETRIES=3
# 整个调用的时间预算，包含 retry
LLM_TIMEOUT=180
# 显式启用 AGY → Codex → API；留空保留原单渠道配置。
LLM_FALLBACK_CHAIN=
# 启用链时建议 LLM_TIMEOUT=600（整个调用）；每次 attempt 最大180秒。
LLM_ATTEMPT_TIMEOUT=180
# 链模式独立模型/effort；旧 LLM_CLI_MODEL/EFFORT 仅用于单渠道。
LLM_AGY_MODEL=
LLM_AGY_EFFORT=
LLM_CODEX_MODEL=
LLM_CODEX_EFFORT=
# Host 上的绝对可执行路径；Python 3 用于请求级进程清理，无需额外安装服务。
LLM_CLI_AGY_PATH=/usr/local/bin/agy
LLM_CLI_CODEX_PATH=/usr/local/bin/codex
LLM_CLI_PYTHON_PATH=/usr/bin/python3
# 留空默认 DATA_DIR/logs/llm；Docker 可设 /workspace/data/logs/llm
LLM_LOG_DIR=

# API（LiteLLM provider/model 格式）
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7

# Host 上已安装并登录的 agy 或 codex；登录态由 Host 维护
LLM_CLI_ENGINE=agy
LLM_CLI_SSH_HOST=host.docker.internal
LLM_CLI_SSH_PORT=22
LLM_CLI_SSH_USERNAME=
LLM_CLI_SSH_PASSWORD=
LLM_CLI_REMOTE_WORKDIR=/tmp/finance-analysis-llm
LLM_CLI_MODEL=
LLM_CLI_EFFORT=

# ===================================
# 通知渠道配置（可同时配置多个，全部推送）
# ===================================
#
# 消息先保存到 notification；未配置外部渠道或被降噪抑制时，消息中心仍可查看。
#
# 【方式一】Telegram 机器人（需同时配置两项）
# 1. 在 Telegram 找 @BotFather -> /newbot -> 获取 Bot Token
# 2. 获取 Chat ID：发消息给 @userinfobot 或访问 https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# 【方式二】ntfy 配置
# NTFY_URL 必须包含 topic path，例如 https://ntfy.sh/my-topic 或 https://self-hosted:port/my-topic
# 系统会解析 topic，并使用 ntfy JSON publish API 发送 Markdown 文本。
# NTFY_URL=
# NTFY_TOKEN=  # 可选，用于需要 Bearer Token 的 topic 或自建 ntfy server
# WEBHOOK_VERIFY_SSL=true  # ntfy HTTPS 证书校验
#
# 持仓风控摘要复用上述全局 Telegram/ntfy，不要求用户填写私人渠道。
# 未配置渠道时仍写入站内消息并完成风控，不回滚。
#
# ===================================
# 数据库配置
# ===================================
#
# 【推荐】PostgreSQL 连接串（Docker Compose 已自动注入，单机开发可手动填写）
# 格式：postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Docker Compose 环境会自动覆盖此值，连接到内部 postgres 容器。
#
# PostgreSQL 凭据（docker-compose 中 postgres 服务使用，需与 DATABASE_URL 一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_analysis

# 必填：PostgreSQL 连接（与 docker-compose.dev.yml 中 postgres 服务一致）
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis 直连配置（Docker Compose 已自动注入，单机开发可手动填写）
REDIS_URL=redis://redis:6379/0

# Shared artifact root used by the Python 3.13 application and the isolated
# Python 3.12 Qlib Celery worker. The worker receives REDIS_URL and this value
# only; it must not receive DATABASE_URL or the complete .env file.
QUANT_ARTIFACT_ROOT=/workspace/data/quant
QUANT_MIN_UNIVERSE_COVERAGE=0.90
# Scheduled training creates no model implicitly and is disabled by default.
QUANT_TRAINING_SCHEDULE_ENABLED=false

# ===================================
# 长桥实时行情 streamer（可选）
# ===================================
# 留空时复用 REDIS_URL，不要求独立 Redis 实例
REALTIME_REDIS_URL=

# ===================================
# Web 登录认证
# ===================================
# 默认启用密码保护；合法用户邮箱须预先写入数据库（首次登录在网页设置密码）
# 用于签名登录 JWT Cookie；留空时首次使用时自动随机生成（未写入 .env 则重启后会话可能失效）
# 生产环境请设置为足够长的随机字符串
SECRET_KEY=

# BTCUSDT Spot 后端策略（页面行情直连 Binance，公开行情无需 API Key）
CRYPTO_ENABLED=true
BINANCE_REST_BASE_URL=https://data-api.binance.vision

# Fuyao public REST fallback (https://fuyao.aicubes.cn/docs)
FUYAO_API_KEY=
FUYAO_TIMEOUT_SECONDS=10

# Admin-only read diagnostics in the existing FastAPI process (see docs/mcp.md).
MCP_ENABLED=false
# At least 32 random ASCII characters.
MCP_API_KEY=
# Optional overrides; default to DATABASE_URL / REDIS_URL.
# Configure dedicated read-only accounts here for stronger permission isolation.
MCP_DATABASE_URL=
MCP_REDIS_URL=
