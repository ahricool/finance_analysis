# ===================================
# Finance Analysis - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================


# 数据源配置
# 东方财富反爬补丁（可选）：true/false，默认 false。
# 仅在访问东方财富接口被风控时开启；开启后会为相关请求注入随机 UA 与授权 Cookie 并随机休眠。
# ENABLE_EASTMONEY_PATCH=false
# TickFlow API Key（可选，用于 A 股大盘复盘指数增强；若套餐支持标的池查询，也可增强市场统计）
# TICKFLOW_API_KEY=
# Longbridge OpenAPI（可选，美股/港股量比、换手率、PE 等字段兜底）
# 从 https://open.longbridge.com/ 获取
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 进程内缓存秒数，默认 86400；0=每次请求拉取
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 连接关闭类异常后的冷却秒数，默认 15；冷却期内会临时跳过 Longbridge，避免请求级频繁重连
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15

# 历史行情同步窗口与 Provider 任务级并发/重试。
# 全量同步和新股票首次回填默认覆盖最近 5 年；已有股票的每日增量同步默认覆盖最近 60 个自然日。
# 每日任务先比较最近 60 天同日期复权因子；如有变化则绕过批次缓存重新拉取并替换完整 5 年窗口。
# 每次任务发起行情请求前，先删除超过保留窗口的日线、公司行动和复权因子。
# MARKET_DATA_INITIAL_DAILY_DAYS=1825   # 全量同步和新股票首次回填窗口（自然日）
# MARKET_DATA_REFRESH_DAILY_DAYS=60     # 已有股票每日增量覆盖更新窗口（自然日）
# MARKET_DATA_TICKFLOW_BATCH_SIZE=100   # TickFlow 单次批量 K 线请求的 symbols 数量（最大 100）
# MARKET_DATA_TICKFLOW_MAX_CONCURRENCY=5 # TickFlow SDK 批量 K 线内部最大并发数
# MARKET_DATA_RETENTION_DAILY_DAYS=1825 # PostgreSQL 日线、公司行动和复权因子保留窗口（自然日）
# MARKET_DATA_LONGBRIDGE_MAX_CONCURRENCY=5
# MARKET_DATA_LONGBRIDGE_MAX_RETRIES=3
# MARKET_DATA_YFINANCE_MAX_CONCURRENCY=3
# MARKET_DATA_YFINANCE_MAX_RETRIES=3
# MARKET_DATA_YFINANCE_BATCH_SIZE=100  # yfinance 单次批量 K 线请求的 symbols 数量（最大 200）
# US 日线同步优先 Alpaca SIP（前复权），未配置或失败自动降级 yfinance。
# 仅用于同步，不影响实时行情、Streamer 或普通历史查询；密钥仅在后端读取。
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Longbridge SDK 语言与 REPORT_LANGUAGE（zh/en）一致。
# SDK 文件日志默认关闭；如需短期排障，可显式设置 LONGBRIDGE_LOG_PATH，排障后应及时移除。
# 接入点（与 REPORT_LANGUAGE 无关；留空则用下列默认值）：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 覆盖接入点；SDK 内部用 LONGPORT_REGION（不带 BRIDGE）自动选择，
# 代码会自动同步 LONGBRIDGE_REGION → LONGPORT_REGION。
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 其余见：https://open.longbridge.com/zh-CN/docs/getting-started#环境变量
# 夜盘行情 true/false，应用默认 true；实际可用性取决于行情权限
# LONGBRIDGE_ENABLE_OVERNIGHT=true
# K 线推送 realtime 或 confirmed，默认 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 连接时是否打印行情包（与 README / full-guide 一致：未设置时应用侧默认为关闭，等同 false）
# 设为 1 / true / yes 开启 SDK 详细行情包日志（调试长桥连接时使用）
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# ===================================
# LLM：固定 Codex → API
# ===================================
# 初始调用 + 最多三次 retry（0–3），退避 2 / 4 / 8 秒
LLM_MAX_RETRIES=3
# 每次尝试最多300秒；没有整条调用的总时间预算。
LLM_ATTEMPT_TIMEOUT=300
LLM_CODEX_MODEL=
LLM_CODEX_EFFORT=
# 留空使用 Codex 默认服务级别；fast 显式启用 Fast 模式（仅 Codex，不影响 API）。
LLM_CODEX_SERVICE_TIER=
LLM_CLI_CODEX_PATH=/usr/local/bin/codex
LLM_CLI_PYTHON_PATH=/usr/bin/python3
LLM_LOG_DIR=

# API（LiteLLM provider/model 格式）
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# API 推理强度，留空不发送；例如 medium。与 Codex effort 独立。
LLM_API_EFFORT=

# Host 上已安装并登录的 Codex；登录态由 Host 维护
LLM_CLI_SSH_HOST=host.docker.internal
LLM_CLI_SSH_PORT=22
LLM_CLI_SSH_USERNAME=
LLM_CLI_SSH_PASSWORD=
LLM_CLI_REMOTE_WORKDIR=/tmp/finance-analysis-llm

# ===================================
# 通知渠道配置（可同时配置多个，全部推送）
# ===================================
#
# 消息先保存到 notification；未配置外部渠道或被降噪抑制时，消息中心仍可查看。
#
# 【方式一】Telegram 机器人（需同时配置两项）
# 1. 在 Telegram 找 @BotFather -> /newbot -> 获取 Bot Token
# 2. 获取 Chat ID：发消息给 @userinfobot 或访问 https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# 【方式二】ntfy 配置
# NTFY_URL 必须包含 topic path，例如 https://ntfy.sh/my-topic 或 https://self-hosted:port/my-topic
# 系统会解析 topic，并使用 ntfy JSON publish API 发送 Markdown 文本。
# NTFY_URL=
# NTFY_TOKEN=  # 可选，用于需要 Bearer Token 的 topic 或自建 ntfy server
# WEBHOOK_VERIFY_SSL=true  # ntfy HTTPS 证书校验
#
# 持仓风控摘要复用上述全局 Telegram/ntfy，不要求用户填写私人渠道。
# 未配置渠道时仍写入站内消息并完成风控，不回滚。
#
# ===================================
# 数据库配置
# ===================================
#
# 【推荐】PostgreSQL 连接串（Docker Compose 已自动注入，单机开发可手动填写）
# 格式：postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Docker Compose 环境会自动覆盖此值，连接到内部 postgres 容器。
#
# PostgreSQL 凭据（docker-compose 中 postgres 服务使用，需与 DATABASE_URL 一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_analysis

# 必填：PostgreSQL 连接（与 docker-compose.dev.yml 中 postgres 服务一致）
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis 直连配置（Docker Compose 已自动注入，单机开发可手动填写）
REDIS_URL=redis://redis:6379/0

# Shared artifact root used by the Python 3.13 application and the isolated
# Python 3.12 Qlib Celery worker. The worker receives REDIS_URL and this value
# only; it must not receive DATABASE_URL or the complete .env file.
QUANT_ARTIFACT_ROOT=/workspace/data/quant
QUANT_MIN_UNIVERSE_COVERAGE=0.90
# Scheduled training creates no model implicitly and is disabled by default.
QUANT_TRAINING_SCHEDULE_ENABLED=false

# ===================================
# 长桥实时行情 streamer（可选）
# ===================================
# 留空时复用 REDIS_URL，不要求独立 Redis 实例
REALTIME_REDIS_URL=
# Empty for standalone development. On Apple Silicon deploy.sh normally supplies
# the managed host URL; set an explicit URL only for a separately managed MPS service.
KRONOS_URL=
KRONOS_MODEL=small

# ===================================
# Web 登录认证
# ===================================
# 默认启用密码保护；合法用户邮箱须预先写入数据库（首次登录在网页设置密码）
# 用于签名登录 JWT Cookie；留空时首次使用时自动随机生成（未写入 .env 则重启后会话可能失效）
# 生产环境请设置为足够长的随机字符串
SECRET_KEY=

# USD-M perpetual contracts (public market data)
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
# Optional dedicated MARKET_DATA key for top trader statistics (used by Streamer).
BINANCE_FUTURES_MARKET_DATA_KEY=

# Fuyao public REST fallback (https://fuyao.aicubes.cn/docs)
FUYAO_API_KEY=
FUYAO_TIMEOUT_SECONDS=10

# Admin-only read diagnostics in the existing FastAPI process (see docs/mcp.md).
MCP_ENABLED=false
# At least 32 random ASCII characters.
MCP_API_KEY=
# Optional overrides; default to DATABASE_URL / REDIS_URL.
# Configure dedicated read-only accounts here for stronger permission isolation.
MCP_DATABASE_URL=
MCP_REDIS_URL=

# Earnings outlook: current Nasdaq-100 stocks only. No trading or notifications.
EARNINGS_OUTLOOK_RESEARCH_TTL_HOURS=24
EARNINGS_OUTLOOK_CONCURRENCY=2
# Calendar horizon is fixed at 30 days; legacy EARNINGS_OUTLOOK_LOOKAHEAD_DAYS is ignored.
EARNINGS_OUTLOOK_EPS_RELATIVE_TOLERANCE=0.02
EARNINGS_OUTLOOK_EPS_ABSOLUTE_USD=0.01
EARNINGS_OUTLOOK_REVENUE_RELATIVE_TOLERANCE=0.01
# OpenAI: set responses for Responses API web_search. Legacy search models may use chat_completions.
# Set unavailable to disable API search, or when the model/gateway lacks search support.
# This declares capability, never proves execution. Citations/tool events are stored separately.
# Codex CLI earnings research explicitly enables live search.
LLM_API_SEARCH_MODE=unavailable

# Options Intelligence: Yahoo primary, Alpaca capability fallback (same existing Alpaca credentials).
OPTIONS_ENABLED=true
# Always explicit: indicative is modified quotes / delayed trades, not NBBO; opra requires entitlement.
OPTIONS_FEED=indicative
# Set to https://api.alpaca.markets for a live-key account; this is used for read-only contract metadata.
ALPACA_OPTIONS_CONTRACTS_URL=https://paper-api.alpaca.markets
OPTIONS_MAX_DTE=90
OPTIONS_MAX_EXPIRATIONS=12
OPTIONS_MAX_CONTRACTS=2500
OPTIONS_MIN_MONEYNESS=0.7
OPTIONS_MAX_MONEYNESS=1.3
OPTIONS_CACHE_SECONDS=900
OPTIONS_QUOTE_MAX_AGE=300
OPTIONS_TIMESTAMP_TOLERANCE=120
OPTIONS_MIN_VOLUME=100
OPTIONS_MIN_OI=100
OPTIONS_MIN_HISTORY_DAYS=20
OPTIONS_HISTORY_DAYS=120
OPTIONS_VOLUME_OI_ALERT=3
OPTIONS_PREMIUM_ALERT=1000000
OPTIONS_PERCENTILE_ALERT=95
OPTIONS_SKEW_ALERT=0.08
# 历史预热期保护需求参考：Put/Call 比率为此值时初始规则分为 50（低可信度）
OPTIONS_PUT_CALL_DEMAND_REFERENCE=1.0
OPTIONS_SKEW_CHANGE_ALERT=0.03
OPTIONS_TERM_INVERSION_ALERT=0.05
# Off by default; when enabled, important events trigger at most one explanation per symbol/session.
OPTIONS_AUTO_EXPLAIN=false
OPTIONS_LLM_SCORE=85

# Polymarket 个股即时搜索：仅短期Redis缓存，无目录/赔率同步任务。
# 当前详情60秒、历史5分钟；Redis是可丢弃的共享短缓存。
POLYMARKET_SEARCH_TTL=300
POLYMARKET_LIVE_TTL=60
POLYMARKET_HISTORY_TTL=300

# 全天滚动形态分析与常规时段模拟交易
INTRADAY_ENTRY_WINDOW_MINUTES=120
ROLLING_MIDDAY_WAVE_BREAKOUT=true
ROLLING_BOX_BREAKOUT=true
ROLLING_TREND_CONTINUATION=true
ROLLING_PIVOT_BREAKOUT=true
ROLLING_TREND_RECOVERY=true
INTRADAY_USE_PIVOT_TARGET=false
# V8 两档 14 日 ATR 棘轮出场（设为 false 可回退 V7 固定波段止损止盈）
INTRADAY_ATR_SCALED_EXITS=true
INTRADAY_ATR_FLOOR_PCT=0.012
INTRADAY_ATR_CAP_PCT=0.080
INTRADAY_ATR_FALLBACK_PCT=0.030
INTRADAY_STOP_LOSS_ATR_MULT=1.20
INTRADAY_TAKE_PROFIT_ATR_MULT=0.0
INTRADAY_RATCHET_TIER1_TRIGGER_ATR=0.50
INTRADAY_RATCHET_TIER1_LOCK_ATR=0.08
INTRADAY_RATCHET_TIER2_TRIGGER_ATR=1.20
INTRADAY_RATCHET_TIER2_LOCK_ATR=0.60
# 旧版 V7 固定波段止损/锁盈参数（仅 INTRADAY_ATR_SCALED_EXITS=false 时生效）
INTRADAY_STOP_LOSS_PCT=0.025
INTRADAY_TAKE_PROFIT_PCT=0.0
INTRADAY_PROFIT_LOCK_TRIGGER_PCT=0.020
INTRADAY_PROFIT_LOCK_LEVEL_PCT=0.002
INTRADAY_MIN_TARGET_RETURN=0.0
INTRADAY_MIN_REWARD_RISK=0.0
INTRADAY_MIN_RISK_RETURN=0.0
INTRADAY_MAX_RISK_RETURN=0.0
INTRADAY_REQUIRE_VWAP=true
INTRADAY_REQUIRE_SPY_ALIGNMENT=true
# 隔夜顺向跳空下限（默认 -0.005，拒绝反向跳空超过 0.5% 的开盘驱动；填 none 关闭）
INTRADAY_MIN_GAP_DIRECTIONAL=-0.005
INTRADAY_MIN_RELATIVE_STRENGTH=0.008
INTRADAY_MIN_OPEN_MOVE=0.012
INTRADAY_MIN_SPY_OPEN_MOVE=0.0015
INTRADAY_MIN_POOL_BREADTH=0.68
INTRADAY_POOL_LEADER_TOP_K=10
# 日内模拟开仓/平仓通知（经全局 NotificationService 写入消息中心并推送 Telegram/ntfy）
INTRADAY_TRADE_NOTIFICATIONS=true

# Official Binance USD-M Demo only. Configure keys created in Demo Trading.
# The administrator controls new orders through the persistent Paper Trade switch.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Binance USD-M Live account monitoring only; trading switch is stored in FA.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
